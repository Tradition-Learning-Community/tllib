{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "tllib explicit conformance decisions v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "specs_commit",
    "features"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "specs_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "features": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "feature_id",
          "disposition",
          "reason",
          "evidence"
        ],
        "properties": {
          "feature_id": {
            "type": "string",
            "pattern": "^TLC-FC-[0-9]{2}-[A-Z][A-Z0-9-]*-[0-9]{3}$"
          },
          "disposition": {
            "enum": [
              "covered",
              "blocked-by-spec",
              "provider-required",
              "structural",
              "unimplemented",
              "invalid"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "test_id",
                "result",
                "artifact",
                "ctest_name"
              ],
              "properties": {
                "test_id": {
                  "type": "string",
                  "minLength": 1
                },
                "result": {
                  "const": "passed"
                },
                "artifact": {
                  "type": "string",
                  "pattern": "^tests/"
                },
                "ctest_name": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
